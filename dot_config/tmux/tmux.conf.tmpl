# use 24-bit true color (if terminal emulator supports)
set-option -sa terminal-overrides ",xterm*:Tc"

set -g mouse off

# start window/pane numbering at 1
set -g base-index 1
set -g pane-base-index 1
set-window-option -g pane-base-index 1
set-option -g renumber-windows on

# set prefix to ctrl-space
unbind C-b
set -g prefix C-Space
bind C-Space send-prefix

# prefix-r to reload config
bind r source-file $XDG_CONFIG_HOME/tmux/tmux.conf \; display "reloaded tmux config $XDG_CONFIG_HOME/tmux/tmux.conf"

# split pane with | and =, and keep current path
bind | split-window -h -c "${pane_current_path}"
bind - split-window -v -c "${pane_current_path}"

# vim-style pane navigation
bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R
bind -r H resize-pane -L 5
bind -r J resize-pane -D 5
bind -r K resize-pane -U 5
bind -r L resize-pane -R 5

# Status bar at top of screen
set -g status-position top

# Status bar colors
set -g status-style 'bg=#{?client_prefix,#2E4737,#13161d} fg=#8b949e'
set -g status-left-length 20
set -g status-right-length 50

# Status bar content
set -g status-left '#[fg=#00A362,bold]  #S #[fg=#30363d]│ '
set -g status-interval 60
set -g status-right '#[fg=#8b949e]#{pane_current_command} #[fg=#30363d]│#[fg=#8b949e] #(TZ=UTC date +%%HZ)~%H:%M #[fg=#30363d]│#[fg=#8b949e] %Y-%m-%d '

# Window status
setw -g window-status-format ' #I:#W#{?window_zoomed_flag,,} '
setw -g window-status-current-format '#[fg=#00A362,bold] #I:#W#{?window_zoomed_flag,,} '



# --- copy mode (vi) ---
setw -g mode-keys vi
set -g set-clipboard on

bind -T copy-mode-vi J send-keys -X -N 10 scroll-down
bind -T copy-mode-vi K send-keys -X -N 10 scroll-up

bind -T copy-mode-vi v send-keys -X begin-selection
bind -T copy-mode-vi C-v send-keys -X rectangle-toggle
{{ $clip := "xclip -selection clipboard -in" -}}
{{ if eq .chezmoi.os "darwin" -}}
{{ $clip = "pbcopy" -}}
{{ else if eq .chezmoi.os "linux" -}}
{{ if contains "microsoft" (lower .chezmoi.kernel.osrelease) -}}
{{ $clip = "win32yank.exe -i --crlf" -}}
{{ end -}}
{{ end -}}
bind -T copy-mode-vi y send-keys -X copy-pipe-and-cancel "{{ $clip }}"
bind -T copy-mode-vi Enter send-keys -X copy-pipe-and-cancel "{{ $clip }}"

bind ] paste-buffer -p

# plugins
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'

# extrakto: fuzzy-pick URLs/paths/tokens from the pane
set -g @plugin 'laktak/extrakto'
set -g @extrakto_key 'u'
set -g @extrakto_filter_order 'word url path line all'
set -g @extrakto_grab_area 'recent'
# @extrakto_key binds one key; add Tab as a second trigger
bind Tab run-shell "$XDG_CONFIG_HOME/tmux/plugins/extrakto/scripts/open.sh \"#{pane_id}\""

# Resurrect: save/restore sessions across restarts
set -g @resurrect-capture-pane-contents 'on'
set -g @continuum-restore 'on'
set -g @continuum-save-interval '15'

run '~/.tmux/plugins/tpm/tpm'
